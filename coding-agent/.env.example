# Same project as gadf/web/.env
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"

# This machine signs in as you to poll/complete tasks and post results back
GADF_EMAIL="you@example.com"
GADF_PASSWORD="your-gadf-login-password"

# Used to run the actual coding agent
ANTHROPIC_API_KEY="sk-ant-..."

# Absolute path to the folder containing your repos (e.g. GitHub\).
# Every repo she's allowed to touch must live directly under this folder.
GITHUB_ROOT="C:\Users\YOU\Documents\GitHub"
